---
layout: base.njk
title: "Productions"
description: "A growing universe of stories, knowledge, and imagination. Explore Olympus Studios productions — Woodland Pond, One Minute Wonders, and Shadow Files."
---

<!-- ═══════════════════════════════════════════════════════════
     PRODUCTIONS HERO (WEB-PRODUCTIONS-V01A)
     ═══════════════════════════════════════════════════════════ -->
<section class="page-header">
  <div class="page-header-bg">
    <img src="/assets/images/hero/productions-hero.svg" alt="Cinematic film strip — Olympus Studios productions" loading="eager">
  </div>
  <div class="page-header-overlay"></div>
  <div class="page-header-content">
    <span class="section-gold-label">Our Productions</span>
    <div class="gold-line"></div>
    <h1 class="page-header-title">OUR PRODUCTIONS</h1>
    <p class="page-header-desc">A growing universe of stories, knowledge, and imagination.</p>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     ACTIVE PRODUCTIONS
     ═══════════════════════════════════════════════════════════ -->
<section class="section">
  <div class="container-wide">
    <h2 class="section-title">ACTIVE PRODUCTIONS</h2>
    <div class="gold-line"></div>
    <p class="section-description">Each production is a unique universe with its own identity, voice, and audience. Explore the worlds we're building.</p>

    <div class="grid-3">
      {% for item in productions.productions %}
      <article class="prod-card" onclick="window.location.href='{{ item.url }}'" role="link" tabindex="0" onkeydown="if(event.key==='Enter'||event.key===' '){window.location.href='{{ item.url }}'}">
        <div class="prod-card-img">
          <img src="{{ item.image }}" alt="{{ item.name }}" loading="lazy">
        </div>
        <div class="prod-card-overlay"></div>
        <div class="prod-card-body">
          <div class="prod-card-tagline">{{ item.tagline }}</div>
          <h3 class="prod-card-title">{{ item.name }}</h3>
          <p class="prod-card-desc">{{ item.description }}</p>
          <a class="prod-card-cta" href="{{ item.url }}" tabindex="-1">{{ item.cta }}</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     FUTURE PRODUCTIONS
     ═══════════════════════════════════════════════════════════ -->
<section class="section section-dark">
  <div class="container-wide">
    <span class="section-gold-label">Coming Soon</span>
    <h2 class="section-title">FUTURE PRODUCTIONS</h2>
    <div class="gold-line"></div>
    <p class="section-description">Currently in development. More stories on the horizon.</p>

    <div class="future-prod-grid">
      {% for item in productions.future_productions %}
      <div class="future-prod-card">
        <svg class="future-prod-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="4" y="11" width="16" height="10" rx="2"/>
          <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
        </svg>
        <span class="future-prod-label">{{ item.label }}</span>
        <span class="future-prod-status">{{ item.status }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     STORIES THAT MATTER
     ═══════════════════════════════════════════════════════════ -->
<section class="section">
  <div class="container">
    <div class="values-grid">
      <div class="vision-text">
        <span class="section-gold-label">Stories That Matter</span>
        <h2>STORIES THAT MATTER</h2>
        <div class="gold-line"></div>
        <p>
          Every production at Olympus Studios is created with purpose. We believe
          in stories that educate, entertain, and inspire positive change.
        </p>
      </div>
      <div class="values-list">
        <div class="values-item">
          <div class="values-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="9" cy="9" r="4"/><circle cx="17" cy="12" r="3"/><path d="M3 21c0-3 3-5 6-5s6 2 6 5M15 21c0-2 1.5-3.5 4-3.5s4 1.5 4 3.5"/></svg>
          </div>
          <span class="values-label">Built for Families</span>
        </div>
        <div class="values-item">
          <div class="values-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18-3-3-3-15 0-18z"/></svg>
          </div>
          <span class="values-label">Created for a Global Audience</span>
        </div>
        <div class="values-item">
          <div class="values-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 21s-7-4.5-9-9a5 5 0 0 1 9-3 5 5 0 0 1 9 3c-2 4.5-9 9-9 9z"/></svg>
          </div>
          <span class="values-label">Driven by Purpose</span>
        </div>
      </div>
    </div>
  </div>
</section>