<footer class="footer">
  <div class="footer-inner">
    <div class="footer-tagline">{{ site.brand.footer_tagline }}</div>

    <div class="footer-links">
      {% for item in navigation.footer %}
      <a href="{{ item.url }}"
         {% if item.external %}target="_blank" rel="noopener"{% endif %}
         {% if item.label === 'YouTube' %}aria-label="YouTube"{% endif %}
         {% if item.label === 'Instagram' %}aria-label="Instagram"{% endif %}
         {% if item.label === 'TikTok' %}aria-label="TikTok"{% endif %}
         {% if item.label === 'Facebook' %}aria-label="Facebook"{% endif %}>
        {{ item.label }}
      </a>
      {% endfor %}
    </div>

    <div class="footer-copyright">
      {{ site.brand.copyright }}
    </div>
  </div>
</footer>